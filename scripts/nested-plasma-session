#!/bin/sh
marker="${XDG_RUNTIME_DIR:-/tmp}/kde-toggle-nested.pid"
session_data="${XDG_RUNTIME_DIR:-/tmp}/kde-toggle-nested-data-$$"
config_home="${XDG_RUNTIME_DIR:-/tmp}/kde-toggle-nested-config-$$"
command_file="${XDG_RUNTIME_DIR:-/tmp}/kde-toggle-decoration.command"
brave_profile="${XDG_CONFIG_HOME:-$HOME/.config}/kde-toggle/brave-nested"
mkdir -p "$session_data/applications" "$config_home" "$brave_profile"
rm -f "$command_file"
printf "[Desktop Entry]\nName=Brave (Nested KDE Toggle)\nType=Application\nExec=brave --user-data-dir=$brave_profile %U\nIcon=brave-browser\nCategories=Network;WebBrowser;\nMimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;\n" > "$session_data/applications/brave-browser.desktop"
export XDG_DATA_HOME="$session_data"
export XDG_DATA_DIRS="$session_data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CONFIG_HOME="$config_home"
export XDG_STATE_HOME="$config_home/state"
export XDG_CACHE_HOME="$config_home/cache"
mkdir -p "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
printf '%s\n' "$PPID" > "$marker"
cleanup() {
    trap - EXIT INT TERM
    if [ -n "${decoration_child:-}" ]; then
        kill "$decoration_child" 2>/dev/null || true
        wait "$decoration_child" 2>/dev/null || true
    fi
    if [ -n "${child:-}" ]; then
        kill "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    rm -f "$marker"
    rm -f "$command_file"
    rm -rf "$session_data" "$config_home"
}
trap cleanup EXIT INT TERM
dbus-run-session /usr/bin/plasmashell --no-respawn &
child="$!"
if [ -n "${KDE_TOGGLE_DECORATION_HELPER:-}" ] && [ -x "$KDE_TOGGLE_DECORATION_HELPER" ]; then
    "$KDE_TOGGLE_DECORATION_HELPER" &
    decoration_child="$!"
fi
wait "$child"
status="$?"
exit "$status"
